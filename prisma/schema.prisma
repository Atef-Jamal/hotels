  Single
  Standard
  Penthouse_Suite
  Double
  Deluxe
  Twin
  Executive_Suite
  Family_Room
}

enum BedTypeEnum {
  Single
  Double
  Queen
  King
  Twin
}

enum PaymentMethod {
  Credit_Card
  Debit_Card
  PayPal
  Bank_Transfer
  Cash
  Mobile_Payment
